# ---------------------------------------------------------------
# RubricRoom configuration. Copy to .env.local and fill in what you have.
# Every key is optional: missing providers are reported honestly in the UI
# ("not configured") instead of being faked.
# ---------------------------------------------------------------

# --- AI provider (Atlas, Scout, Nova, Verdict, Forge, Prism, Sprint) ---
# auto | anthropic | openai | none
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
# Default model is claude-opus-5-5. Override if you want something cheaper.
AI_MODEL=claude-opus-5-5
# Server-side refusal fallbacks on the Claude API (on | off)
AI_FALLBACKS=on
# fast | standard. fast = Opus fast mode: about 2x quicker replies at 2x the token price
# (Claude API only). Falls back to standard speed automatically if unavailable.
AI_SPEED=fast
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Quicker, cheaper model for the Judge's Room opening question (so the room opens in seconds).
# Leave empty for the default: gpt-5-mini with OpenAI, claude-haiku-5-5 with Anthropic.
AI_FAST_MODEL=

# --- Web search provider (competitor + opportunity research) ---
# auto | tavily | exa | none
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
EXA_API_KEY=

# --- GitHub REST API (works without a token at a lower rate limit) ---
GITHUB_TOKEN=

# --- Database ---
# Leave empty to use an embedded PGlite database in ~/.rubricroom/pglite (local dev only).
# Keep PGLITE_DIR outside this folder: `next dev` reloads the page on every file change in it.
# For public deployment, use a hosted Postgres (Neon, Supabase, RDS...).
DATABASE_URL=
PGLITE_DIR=

# --- Public-demo protection ---
# Shared daily AI spending cap in US$, estimated from token usage at list price (GPT-5: $1.25/$10
# per million input/output tokens; Opus 5.5: $4/$20, doubled in fast mode). Override the price for
# other models with AI_PRICE_INPUT_PER_M / AI_PRICE_OUTPUT_PER_M. Past the cap, agents answer
# rule-based until 00:00 UTC. Also set a hard limit in your provider's billing dashboard.
AI_DAILY_BUDGET_USD=3
RATE_LIMIT_AI_PER_IP_HOUR=30
RATE_LIMIT_AI_PER_HOUR=60
RATE_LIMIT_JOBS_PER_HOUR=12
RATE_LIMIT_IP_PER_DAY=300
