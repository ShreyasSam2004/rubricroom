{
  "name": "rubricroom",
  "version": "0.1.0",
  "private": true,
  "description": "RubricRoom — challenge your hackathon idea before the judges do.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:refresh": "tsx scripts/refresh-seed.ts",
    "examples:capture": "tsx --env-file=.env.local scripts/capture-examples.ts",
    "check:schemas": "tsx --env-file=.env.local scripts/check-schemas.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@electric-sql/pglite": "0.5.12",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "undici": "8.12.3",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
